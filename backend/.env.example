# ============================================================
# FutureMeal Backend Environment Variables
# Copy to .env and set real values — NEVER commit .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/futuremeal_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=yourpassword

# ── JWT ──────────────────────────────────────────────────────
# Must be >= 256 bits (32+ characters) for HS256
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI Service (optional) ────────────────────────────────────
# Set AI_ENABLED=true and configure below to enable AI recommendations
AI_ENABLED=false
AI_PROVIDER=none
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o-mini

# ── Payment Gateway (optional) ───────────────────────────────
# Set PAYMENT_GATEWAY=razorpay and configure to enable live payments
PAYMENT_GATEWAY=none
# PAYMENT_GATEWAY=razorpay
# PAYMENT_KEY_ID=rzp_test_xxxxxx
# PAYMENT_KEY_SECRET=your_razorpay_secret

# ── Seed Data ────────────────────────────────────────────────
SEED_DATA_ENABLED=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
SHOW_SQL=false
JPA_DDL_AUTO=update
